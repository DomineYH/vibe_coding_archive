[Unit]
Description=EduVibe scheduled health batch admission

[Service]
Type=oneshot
User=eduvibe
Group=eduvibe
WorkingDirectory=/opt/eduvibe/current/backend
EnvironmentFile=/etc/eduvibe/runtime.env
Environment=APP_ENV=production
Environment=HEALTH_CHECKS_ENABLED=false
Environment=HEALTH_WORKER_LOCK_PATH=/srv/eduvibe/worker/health-worker.lock
ExecStart=/opt/eduvibe/current/backend/.venv/bin/python -m app.cli health-batch
Restart=no
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=15s
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=yes
LimitCORE=0
LogNamespace=eduvibe
StandardOutput=journal
StandardError=journal
