{
  "name": "eduvibe-archive-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": "12.0.2"
  },
  "scripts": {
    "dev": "VITE_DATA_MODE=mock vite --host localhost --port 5173 --strictPort",
    "dev:api": "VITE_DATA_MODE=api vite --host localhost --port 5174 --strictPort",
    "build": "npm run typecheck && VITE_DATA_MODE=api vite build --mode production --outDir dist",
    "build:mock": "npm run typecheck && VITE_DATA_MODE=mock vite build --mode mock --outDir dist-mock",
    "check:dist": "node scripts/check-dist.mjs",
    "check:reference": "node scripts/check-reference.mjs",
    "mock:reset": "node scripts/mock-reset.mjs",
    "openapi:lint": "redocly lint ../contracts/openapi.yaml",
    "openapi:generate": "openapi-typescript ../contracts/openapi.yaml -o src/contracts/api.d.ts",
    "openapi:check": "node scripts/check-openapi.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run openapi:lint && npm run openapi:check && npm run typecheck && npm run lint && npm run format:check",
    "test": "VITE_DATA_MODE=mock vitest run",
    "test:watch": "VITE_DATA_MODE=mock vitest",
    "test:e2e": "playwright test",
    "test:e2e:api": "node scripts/test-api-e2e.mjs",
    "test:visual": "playwright test --config=playwright.visual.config.js"
  },
  "dependencies": {
    "@tanstack/react-query": "5.66.9",
    "lucide-react": "0.453.0",
    "pretendard": "1.3.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.54.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.3.4",
    "ajv": "6.15.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "js-yaml": "4.3.2",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "6.4.3",
    "vitest": "5.0.1"
  }
}
