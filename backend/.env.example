# 개발 환경 기본값. 프로세스 환경 변수가 이 파일보다 우선합니다.
APP_ENV=development
# 개발 상대 경로는 저장소 루트 기준입니다.
DATABASE_PATH=storage/development.sqlite3
# 프런트엔드의 정확한 origin (경로/끝 슬래시 제외)
PUBLIC_ORIGIN=http://localhost:5174
# 비워 두면 DB 옆 password-blocklist-ncsc.txt 사용; 검증된 R15 목록을 별도 준비합니다.
PASSWORD_BLOCKLIST_PATH=

# 승인된 공개 연락 값만 지정; 빈 값은 null, 잘못된 값은 시작 거절, 변경 후 재시작합니다.
SUPPORT_EMAIL=
SUPPORT_SERVICE_URL=
SUPPORT_ANNOUNCEMENT_URL=

# 개발 API의 기본 재검사 비활성은 의도된 안전 제한이며 미구현/외부 사이트 장애가 아닙니다. false를 유지합니다.
# HEALTH_CHECKS_ENABLED=true만으로 켜지지 않습니다. 승인 기록·8그룹 검증 증거·worker 준비 heartbeat와 mock/격리 검증 경로는 ../docs/operations/health-checks.md 참조.
HEALTH_CHECKS_ENABLED=false
# 지정 DNS IP 목록과 자체 호스트/서비스/변환 대역의 차단 IP/CIDR 목록(쉼표 구분).
HEALTH_DNS_SERVERS=
HEALTH_DENIED_IPS=
# 별도 worker의 승인된 Linux 비특권 UID 및 수명 동안 유지할 잠금 경로.
HEALTH_WORKER_UID=
HEALTH_WORKER_LOCK_PATH=/run/eduvibe/health-worker.lock
HEALTH_ACTIVATION_PATH=

# 운영은 이 파일을 읽지 않습니다. 아래 값은 서비스 프로세스 환경에 명시합니다.
# 공개 검수/외부 ingress는 별도이며 HEALTH_CHECKS_ENABLED=false를 유지합니다.
# 기존 DB/WAL/SHM 0600, 데이터 디렉터리 0700, 서비스 UID 소유를 별도 준비합니다.
# APP_ENV=production
# DATABASE_PATH=/srv/eduvibe/data/production.sqlite3
# PUBLIC_ORIGIN=https://archive.example.com
# PASSWORD_BLOCKLIST_PATH=/srv/eduvibe/data/password-blocklist-ncsc.txt
# PASSWORD_RESET_HMAC_PATH=/srv/eduvibe/data/password-reset-hmac.json
# 승인 없는 후보는 off. 기록은 운영자만 작성하고 APP_RELEASE_ID와 함께 지정합니다.
# AUTH_ACTIVATION_PATH=/srv/eduvibe/data/auth-candidate.json
# APP_RELEASE_ID=<immutable-full-release-id>
